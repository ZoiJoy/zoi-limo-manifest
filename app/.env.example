# Copy this file to .env and fill in what you need. Everything is optional.

PORT=3000

# Password to open the app (strongly recommended when hosted online).
APP_PASSWORD=

# Public web address of this app, used for the "view invoice" link sent to customers.
# e.g. https://book.zoilimo.com   (leave blank to use whatever address you opened the app on)
PUBLIC_URL=

# --- Automatic email (SMTP). Without this, the app opens your phone's mail app instead. ---
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
#        SMTP_PASS=a 16-character App Password (Google Account > Security > App passwords)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional "from" address if different from SMTP_USER
SMTP_FROM=

# --- Automatic text messages (Twilio). Without this, the app opens your phone's Messages app instead. ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio phone number, e.g. +18325551234 (or use a Messaging Service SID instead)
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
